rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. СЛУЖЕБНЫЙ ДОСТУП FLUTTERFLOW CMS (Единый блок для всех коллекций)
    match /{document=**} {
      allow read, write: if request.auth != null && 
        request.auth.token.email != null && 
        request.auth.token.email == "firebase@flutterflow.io";
    }

    // 2. ДИАЛОГИ (Исправлено совпадение полей uid -> user_id)
    match /conversations/{document} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.user_id;
      allow read, write: if request.auth != null && request.auth.uid == resource.data.user_id;
      allow delete: if false;
    }

    // 3. ПУБЛИЧНЫЕ СПРАВОЧНИКИ (Доступны всем на чтение)
    match /education_levels/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /subjects/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /ailbee-books/{document} {
      allow read: if true;
      allow write: if false;
    }

    // 4. СИСТЕМНЫЕ ЛОГИ
    match /export_logs/{document} {
      allow create: if request.auth != null;
      allow read, write, delete: if false;
    }

    // 5. ДАННЫЕ ПОЛЬЗОВАТЕЛЯ
    match /ailbee-user-data/{document} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow read, write: if request.auth != null && request.auth.uid == resource.data.uid;
      allow delete: if false;
    }

    // 6. ЗАМЕТКИ И ИНСАЙТЫ
    match /saved_insights/{document} {
      allow create: if request.auth != null && request.resource.data.user_ref == /databases/$(database)/documents/users/$(request.auth.uid);
      allow read, write, delete: if request.auth != null && resource.data.user_ref == /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // 7. ЗАДАЧИ
    match /tasks/{document} {
      allow create: if request.auth != null && request.resource.data.user_ref == /databases/$(database)/documents/users/$(request.auth.uid);
      allow read, write, delete: if request.auth != null && resource.data.user_ref == /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // 8. ПРОФИЛИ ПОЛЬЗОВАТЕЛЕЙ
    match /users/{document} {
      allow create: if request.auth != null;
      allow read, write: if request.auth != null && (request.auth.uid == document || request.auth.uid == resource.data.uid);
      allow delete: if false;
    }

  }
}
